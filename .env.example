# --- Pipeline lanes (all tunable; see workspace/ocr_pipeline/pipeline_config.py) ---
# Lane 1: EasyOCR => RAW => DeepSeek enrich
# PIPELINE_RAW_OCR_ENGINE=easyocr
# PIPELINE_RAW_OCR_MODEL=docling-easyocr
# PIPELINE_SOURCE_RAW=local_llm_ocr
# PIPELINE_RAW_ENRICH_MODEL=deepseek-v4-pro
# PIPELINE_SOURCE_RAW_ENRICH=deepseek_cleanup

# Lane 2: Gemini Flash OCR (ảnh) => DeepSeek Pro enrich metadata (khuyến nghị)
# PIPELINE_VISION_PROVIDER=google
# PIPELINE_VISION_MODEL=gemini-2.5-flash
# PIPELINE_VISION_API_URL=https://generativelanguage.googleapis.com/v1beta
# PIPELINE_SOURCE_VISION=google_vision
# PIPELINE_PRIORITY_VISION=70
# Lane 2 enrich: DeepSeek trên text Gemini (tách quota OCR vs metadata)
# PIPELINE_VISION_ENRICH_PROVIDER=aibox
# PIPELINE_VISION_ENRICH_MODEL=deepseek-v4-pro
# PIPELINE_VISION_ENRICH_ENABLED=true
# PIPELINE_VISION_ENRICH_FALLBACK_INHERIT=false
# PIPELINE_VISION_BATCH_SLEEP_SECONDS=45
# PIPELINE_VISION_TIMEOUT_SECONDS=300
# PIPELINE_VISION_MAX_EDGE=2048

# Shared text-enrich API (AI Box / OpenAI-compatible)
# PIPELINE_ENRICH_API_URL=https://api.ai-box.vn
# PIPELINE_ENRICH_API_KEY=  # defaults to AI_BOX_API_KEY
# PIPELINE_ENRICH_MAX_CHARS=12000

# Ingest allowlist + per-type strategy (all → documents.markdown)
# PIPELINE_INGEST_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.m4a,.mp3
# PIPELINE_INGEST_PDF_STRATEGY=docling_ocr
# PIPELINE_INGEST_DOCX_STRATEGY=docling_parse
# PIPELINE_INGEST_XLSX_STRATEGY=docling_parse
# PIPELINE_INGEST_IMAGE_STRATEGY=docling_ocr
# PIPELINE_INGEST_AUDIO_STRATEGY=asr

# Default group key for text/chat (e.g. DeepSeek). Do NOT use Codex group here (10 RPM, image models only).
# gemini-3-flash / gemini-3-flash-thinking are image-only; use a separate Codex API key if needed.
AI_BOX_API_KEY=your-api-key-here
AI_BOX_API_URL=https://api.ai-box.vn
AI_BOX_MODEL=deepseek-v4-pro

# Vision OCR via Google API (free-tier friendly, call slowly)
# GOOGLE_API_KEY=AIza...
# GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_VISION_MODEL=gemini-2.5-flash
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_VISION_RATE_LIMIT=10/m

# PostgreSQL catalog (local docker on port 5433)
OCR_DATABASE_URL=postgresql://ocr:ocr@127.0.0.1:5433/ocr_catalog

# OwnCloud Infinite Scale (OCIS) — NOT Nextcloud. See infra/README.md.
OWNCLOUD_URL=https://127.0.0.1:9200
OWNCLOUD_USER=admin
OWNCLOUD_PASSWORD=admin
OWNCLOUD_INSECURE=true
# Optional desktop sync folder for sha256/local OCR path mapping
# OWNCLOUD_LOCAL_SYNC_DIR=/Users/you/OwnCloud

# Teable UI mirror (sync Postgres catalog via API — token in .env only, never commit)
# TEABLE_API_URL=https://noibo.hungthinh.hospital/api
# TEABLE_API_TOKEN=your-personal-access-token
# TEABLE_BASE_ID=bsey3ggz3jrRk1sOMqq
# TEABLE_TABLE_DOCUMENTS_ID=tblNwc8A1llcPa0JcsA
# TEABLE_TABLE_PROMPTS_ID=tbluFFwWvqfWYyngD7r
# TEABLE_TABLE_EXTRACTIONS_ID=tblnLAXYbsxFtuFhbJa
# Teable field setup (run once or when schema changes)
# uv run python scripts/setup_teable_catalog_fields.py
# uv run python scripts/sync_catalog_to_teable.py --ensure-fields
