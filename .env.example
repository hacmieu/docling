# Default group key for text/chat (e.g. DeepSeek). Do NOT use Codex group here (10 RPM, image models only).
# gemini-3-flash / gemini-3-flash-thinking are image-only; use a separate Codex API key if needed.
AI_BOX_API_KEY=your-api-key-here
AI_BOX_API_URL=https://api.ai-box.vn
AI_BOX_MODEL=deepseek-v4-pro

# Vision OCR via Google API (free-tier friendly, call slowly)
# GOOGLE_API_KEY=AIza...
# GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_VISION_MODEL=gemini-2.5-flash
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_VISION_RATE_LIMIT=10/m

# PostgreSQL catalog (local docker on port 5433)
OCR_DATABASE_URL=postgresql://ocr:ocr@127.0.0.1:5433/ocr_catalog

# OwnCloud Infinite Scale (OCIS) — NOT Nextcloud. See infra/README.md.
OWNCLOUD_URL=https://127.0.0.1:9200
OWNCLOUD_USER=admin
OWNCLOUD_PASSWORD=admin
OWNCLOUD_INSECURE=true
# Optional desktop sync folder for sha256/local OCR path mapping
# OWNCLOUD_LOCAL_SYNC_DIR=/Users/you/OwnCloud

# Teable UI mirror (sync Postgres catalog via API — token in .env only, never commit)
# TEABLE_API_URL=https://noibo.hungthinh.hospital/api
# TEABLE_API_TOKEN=your-personal-access-token
# TEABLE_BASE_ID=bsey3ggz3jrRk1sOMqq
# TEABLE_TABLE_DOCUMENTS_ID=tblNwc8A1llcPa0JcsA
# TEABLE_TABLE_PROMPTS_ID=tbluFFwWvqfWYyngD7r
# TEABLE_TABLE_EXTRACTIONS_ID=tblnLAXYbsxFtuFhbJa
# Teable field setup (run once or when schema changes)
# uv run python scripts/setup_teable_catalog_fields.py
# uv run python scripts/sync_catalog_to_teable.py --ensure-fields
