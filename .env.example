# Default group key for text/chat (e.g. DeepSeek). Do NOT use Codex group here (10 RPM, image models only).
# gemini-3-flash / gemini-3-flash-thinking are image-only; use a separate Codex API key if needed.
AI_BOX_API_KEY=your-api-key-here
AI_BOX_API_URL=https://api.ai-box.vn
AI_BOX_MODEL=deepseek-v4-pro

# PostgreSQL catalog (local docker on port 5433)
OCR_DATABASE_URL=postgresql://ocr:ocr@127.0.0.1:5433/ocr_catalog

# OwnCloud local (docker default)
OWNCLOUD_URL=http://127.0.0.1:8088
OWNCLOUD_USER=admin
OWNCLOUD_PASSWORD=admin
# Optional desktop sync folder for sha256/local OCR path mapping
# OWNCLOUD_LOCAL_SYNC_DIR=/Users/you/OwnCloud
